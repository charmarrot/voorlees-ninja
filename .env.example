# ---- Google Cloud ----------------------------------------------------------
# Plak hier de VOLLEDIGE inhoud van je service-account key (JSON, of base64
# daarvan). In Coolify: Environment Variables -> nieuwe secret GCP_SA_JSON.
GCP_SA_JSON={"type":"service_account","project_id":"..."}

GCP_PROJECT_ID=voorlees-ninja-506310
GCP_LOCATION=us-central1

# Modellen (alleen aanpassen als je iets anders wilt proberen)
TEXT_MODEL=gemini-2.5-flash
IMAGE_MODEL=gemini-2.5-flash-image

# Experimenteel: het liedje echt laten zingen via Lyria. Staat bij Google
# nog in preview, en (nog) niet in elke regio -- vandaar een eigen locatie.
MUSIC_MODEL=lyria-3-pro-preview
MUSIC_LOCATION=global

# ---- App -------------------------------------------------------------------
# Gedeelde pincode voor toegang. Leeg laten = iedereen mag erbij (niet doen
# als de app publiek staat).
APP_PIN=1234

# Willekeurige lange string. Zonder deze waarde moet iedereen na elke
# herstart opnieuw de pincode invoeren.
# Genereer er een met: openssl rand -hex 32
SECRET_KEY=verander-dit-in-iets-langs-en-willekeurigs

# Hoeveel dagen een tablet ingelogd blijft
SESSION_DAYS=60

# Rem op de kosten: maximaal aantal verhalen per dag
MAX_STORIES_PER_DAY=25

# Standaard voorleesstem (in de app zelf ook te kiezen)
TTS_VOICE=nl-NL-Wavenet-E

# Waar de verhalen worden bewaard (in de container het gemounte volume)
DATA_DIR=/data
